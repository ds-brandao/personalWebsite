{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-website",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "personal-website"
    }
  ],
  // Incremental cache (R2 not enabled on this account; KV is equivalent here)
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "1dc32be517ee419db64e7e5d533bcf22"
    }
  ],
  // Production serves the apex and www only.
  // www is a custom domain so DNS exists; the app 301s it to the apex.
  // No preview URLs: *.workers.dev hostnames skip the zone's WAF rules
  // (challenge, geo block) yet run with the production secrets, and each
  // version's URL stays live after its PR closes.
  "workers_dev": false,
  "preview_urls": false,
  // Caps /r/ requests per client IP (see app/r/[slug]/route.ts). The
  // namespace is account-wide: keep the id unique across this account's Workers.
  "ratelimits": [
    {
      "name": "LINK_RATE_LIMITER",
      "namespace_id": "1101",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "routes": [
    {
      "pattern": "dbrandao.com",
      "custom_domain": true
    },
    {
      "pattern": "www.dbrandao.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
